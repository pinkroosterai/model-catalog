# ModelCatalog — copy to .env beside this file, mode 600, and fill in.
# Complete by design (architecture-guideline.md §5): every key this stack reads is listed here
# with no value, so the stack can be rebuilt from the repository plus this file plus the values.

# --- image ------------------------------------------------------------------
# Which tag to run. Unset means `current`, which follows main. Set it to a git short sha to
# roll back: that is the whole rollback procedure, plus `docker compose up -d`.
IMAGE_TAG=

# --- networks ---------------------------------------------------------------
# Both are external and shared with the rest of the estate. Unset means the real names.
# Override only for a dev stack, which must never join the real edge.
EDGE_NETWORK=
TELEMETRY_NETWORK=

# --- refresh credential -----------------------------------------------------
# Gates POST /v1/refresh, which is otherwise the only write in the service. With no key
# configured the endpoint answers 503 (disabled), so leaving these empty is a valid read-only
# deployment rather than a broken one.
#
# The endpoint is 404'd at the edge in Caddy, so this credential is reachable only from the
# edge network — it is not the estate's second public password. Generate with:
#   openssl rand -hex 32
ModelRegistry__ApiKeys__0__Name=
ModelRegistry__ApiKeys__0__Key=

# --- optional overrides -----------------------------------------------------
# All have working defaults in appsettings.json; listed so a reader knows they exist.
# Hours before /healthz reports degraded and /v1/meta reports unhealthy. Default 72.
ModelRegistry__StaleThresholdHours=
# Quartz cron for the daily sync. Default "0 0 1 * * ?" (01:00 UTC). Also the source of
# feed_expected_interval_seconds, so changing it changes what the stale-feed alert expects.
ModelRegistry__SyncCron=
# Whether to sync immediately on boot. Default true.
ModelRegistry__RunSyncOnStartup=
